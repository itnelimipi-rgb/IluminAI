# ==========================================
# IluminAI - Global Environment Configuration
# ==========================================
# Copy this file to .env in the respective service directories (e.g. frontend/.env, backend/.env)

# ------------------------------------------
# Frontend - Supabase Integration
# ------------------------------------------
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_anon_key"
SUPABASE_URL="https://your_supabase_project_id.supabase.co"

VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_anon_key"
VITE_SUPABASE_URL="https://your_supabase_project_id.supabase.co"

# ------------------------------------------
# AI / LLM Configuration (OpenAI or Groq)
# ------------------------------------------
# Groq (Free tier available for ultra-fast inference)
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_KEY="gsk_your_groq_api_key_here"

# OpenAI (Alternative)
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o"
# LLM_KEY="sk-your_openai_api_key_here"

# ------------------------------------------
# Backend - Live Clinical Data Collection
# ------------------------------------------
BRIGHT_DATA_API_KEY="your_bright_data_api_key_here"
