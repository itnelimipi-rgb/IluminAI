# ==========================================
# IluminAI - Root .gitignore
# ==========================================

# Compressed Archives & Large Files (DO NOT commit backup zips)
*.zip
*.tar.gz
*.7z
*.rar

# Node / Frontend Dependencies & Builds
node_modules/
dist/
dist-ssr/
build/
.output/
.nitro/
.vinxi/
.tanstack/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun.lockb

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Database Journals & Temporary Locks
*.db-journal
*.sqlite3-journal

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Testing & Coverage
coverage/
*.lcov
.nyc_output/
